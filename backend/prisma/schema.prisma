  title       String
  description String
  icon        String?
  rewardXp    Int         @default(10)
  rewardBadge BadgeType?
  goal        Int         @default(1)
  conditions  Json?
  status      QuestStatus @default(ACTIVE)
  startsAt    DateTime?
  expiresAt   DateTime?
  completedAt DateTime?
