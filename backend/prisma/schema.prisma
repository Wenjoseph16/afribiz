  @@index([businessId, date])
  @@index([date])
}

model ProductDailyStats {
  id            String   @id @default(uuid())
  productId     String
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date          DateTime
  views         Int      @default(0)
  clicks        Int      @default(0)
  orders        Int      @default(0)
