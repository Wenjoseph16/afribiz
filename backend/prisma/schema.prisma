  @@index([avgScore])
}

// ============================================
// DEVELOPER MODELS
// ============================================

model DeveloperProfile {
  id                     String                      @id @default(uuid())
  userId                 String                      @unique
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName            String?
  description            String?
  logo                   String?
  website                String?
  phone                  String?
  email                  String?
  country                String?
  city                   String?
  skills                 String[]
  specialties            String[]
  technologies           String[]
  experience             Int?
  portfolio              String?
  github                 String?
  linkedin               String?
  whatsapp               String?
  address                String?
  photo                  String?
  identityDocument       String?
  companyDocument        String?
  responsiblePhoto       String?
  verifiedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  isActive               Boolean                     @default(true)
  isVerified             Boolean                     @default(false)
  verificationStatus     DeveloperVerificationStatus @default(PENDING)
  rating                 Float                       @default(0)
  reviewCount            Int                         @default(0)
  modules                DeveloperModule[]
  supportTickets         DeveloperSupportTicket[]
  revenues               DeveloperRevenue[]
  payouts                DeveloperPayout[]
  developerModuleReviews DeveloperModuleReview[]
  apiKeys                DeveloperApiKey[]
  webhooks               ModuleWebhook[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  DeveloperBadge         DeveloperBadge[]
  followers              Follow[]

  @@index([userId])
}

model DeveloperModule {
  id                          String                        @id @default(uuid())
  developerId                 String
  developer                   DeveloperProfile              @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name                        String
  slug                        String                        @unique
  description                 String?
  fullDescription             String?
  logo                        String?
  images                      String[]
  price                       Decimal?                      @db.Decimal(12, 2)
  currency                    String                        @default("FCFA")
  isFree                      Boolean                       @default(false)
  isActive                    Boolean                       @default(true)
  isPublished                 Boolean                       @default(false)
  status                      ModuleStatus                  @default(DRAFT)
  isVerified                  Boolean                       @default(false)
  isFeatured                  Boolean                       @default(false)
  category                    String?
  subcategory                 String?
  tags                        String[]
  features                    String[]
  requirements                String?
  setupGuide                  String?
  version                     String                        @default("1.0.0")
  rating                      Float                         @default(0)
  reviewCount                 Int                           @default(0)
  totalInstalls               Int                           @default(0)
  totalSales                  Int                           @default(0)
  totalRevenue                Decimal                       @default(0) @db.Decimal(12, 2)
  publishedAt                 DateTime?
  archivedAt                  DateTime?
  pricingType                 ModulePricingType?
  installations               DeveloperModuleInstallation[]
  reviews                     DeveloperModuleReview[]
  revenues                    DeveloperRevenue[]
  supportTickets              DeveloperSupportTicket[]
  versions                    DeveloperModuleVersion[]
  webhooks                    ModuleWebhook[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  ModulePermission            ModulePermission[]
  ModuleConfiguration         ModuleConfiguration[]
  ModuleActivityLog           ModuleActivityLog[]
  ModuleManifest              ModuleManifest?
  ModuleCommission            ModuleCommission[]
  DeveloperModuleSubscription DeveloperModuleSubscription[]
  ModuleLicense               ModuleLicense[]
  ModuleAnalytics             ModuleAnalytics[]
  ModuleErrorLog              ModuleErrorLog[]
  ModuleValidation            ModuleValidation[]

  @@index([developerId])
  @@index([slug])
  @@index([isPublished])
  @@index([category])
}

model DeveloperModuleVersion {
  id               String             @id @default(uuid())
  moduleId         String
  module           DeveloperModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  version          String
  releaseNotes     String?
  changelog        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ModuleManifest   ModuleManifest[]
  ModuleValidation ModuleValidation[]

  @@unique([moduleId, version])
  @@index([moduleId])
}

model DeveloperModuleInstallation {
  id                  String               @id @default(uuid())
  moduleId            String
  module              DeveloperModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  businessId          String
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status              String               @default("ACTIVE")
  autoUpdate          Boolean              @default(false)
  installedAt         DateTime             @default(now())
  uninstalledAt       DateTime?
  settings            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ModuleConfiguration ModuleConfiguration?
  ModuleActivityLog   ModuleActivityLog[]

  @@index([moduleId])
  @@index([businessId])
}

model DeveloperModuleReview {
  id          String           @id @default(uuid())
  moduleId    String
  module      DeveloperModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  developerId String
  developer   DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int              @default(5)
  title       String?
  comment     String?
  response    String?
  responseAt  DateTime?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([moduleId, userId])
  @@index([moduleId])
  @@index([userId])
}

model DeveloperSupportTicket {
  id          String                    @id @default(uuid())
  developerId String
  developer   DeveloperProfile          @relation(fields: [developerId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  moduleId    String?
  module      DeveloperModule?          @relation(fields: [moduleId], references: [id])
  category    String?
  subject     String
  description String?
  priority    String                    @default("MEDIUM")
  status      String                    @default("OPEN")
  messages    DeveloperSupportMessage[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([developerId])
  @@index([businessId])
  @@index([status])
}

model DeveloperSupportMessage {
  id         String                 @id @default(uuid())
  ticketId   String
  ticket     DeveloperSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User                   @relation(fields: [senderId], references: [id])
  content    String
  attachment String?
  createdAt  DateTime               @default(now())

  @@index([ticketId])
  @@index([senderId])
}

model DeveloperRevenue {
  id               String               @id @default(uuid())
  developerId      String
  developer        DeveloperProfile     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           DeveloperModule?     @relation(fields: [moduleId], references: [id])
  type             DeveloperRevenueType
  amount           Decimal              @db.Decimal(12, 2)
  commissionRate   Decimal              @db.Decimal(5, 4)
  commissionAmount Decimal              @db.Decimal(12, 2)
  netAmount        Decimal              @db.Decimal(12, 2)
