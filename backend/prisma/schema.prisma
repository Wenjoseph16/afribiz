  isNew               Boolean                    @default(true)
  isTopSeller         Boolean                    @default(false)
  isTopProvider       Boolean                    @default(false)
  isRecommended       Boolean                    @default(false)
  taxId               String?
  businessLicense     String?
  managerName         String?
  managerBio          String?
  experience          Int?
  skills              String[]
  certifications      String[]
