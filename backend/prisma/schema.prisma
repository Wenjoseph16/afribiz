  sourceId         String? // e.g., Order ID, Subscription ID
  sourceType       String? // e.g., ORDER, SUBSCRIPTION
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ModuleCommission ModuleCommission?

  @@index([developerId])
  @@index([moduleId])
  @@index([type])
  @@index([status])
}

model DeveloperPayout {
  id               String           @id @default(uuid())
  developerId      String
  developer        DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(12, 2)
  currency         String           @default("FCFA")
  method           String
  status           String           @default("PENDING") // e.g., PENDING, COMPLETED, FAILED
  notes            String?
  requestedAt      DateTime         @default(now())
  processedAt      DateTime?
  transactionId    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([developerId])
  @@index([status])
}

// ============================================
// DEVELOPER API KEY & WEBHOOK MODELS
// ============================================

model DeveloperApiKey {
