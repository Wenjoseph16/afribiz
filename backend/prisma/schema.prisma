// ============================================
// PHASE 0.1 — SECURITY & AUTH HARDENING
// ============================================

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAction {
  BLOCK
  FLAG
  LOG
  CHALLENGE_2FA
}

model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  exp       DateTime
  revokedAt DateTime @default(now())

  @@index([jti])
  @@index([userId])
  @@index([exp])
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceName   String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@index([credentialId])
}

model FraudRule {
  id        String        @id @default(uuid())
  name      String
  type      String // VELOCITY | GEO | BEHAVIORAL | ML
  config    Json // Rule configuration as JSON
  isActive  Boolean       @default(true)
  priority  Int           @default(0)
  action    FraudAction
  severity  FraudSeverity @default(MEDIUM)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type, isActive])
  @@index([isActive, priority])
}

model FraudEvent {
  id         String        @id @default(uuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId String?
  ruleId     String?
  ruleName   String
  eventType  String
  severity   FraudSeverity
  action     FraudAction
  blocked    Boolean       @default(false)
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  country    String?
  city       String?
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([businessId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@index([ipAddress])
}

model AdminKyc {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityDocument   String?
  identityType       String? // CNI | PASSPORT | RESIDENCE_PERMIT
  identityNumber     String?
  missionLetter      String?
  facePhoto          String?
  verificationStatus String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedAt         DateTime?
  verifiedBy         String?
  rejectionReason    String?
  submittedAt        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([verificationStatus])
}

// ============================================
// PHASE 1 — OBSERVABILITY & ANALYTICS
// ============================================

model DeadLetterEvent {
  id            String    @id @default(uuid())
  eventType     String
  payload       Json?
  error         String
  errorStack    String?
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)
  status        String    @default("PENDING") // PENDING | RETRYING | FAILED | ARCHIVED
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([nextRetryAt])
  @@index([createdAt])
}

model CronLock {
  id         String    @id @default(uuid())
  jobName    String    @unique
  status     String    @default("IDLE") // IDLE | RUNNING | FAILED
  lockedAt   DateTime  @default(now())
  unlockedAt DateTime?
  lastError  String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([lockedAt])
}

model PageView {
  id         String    @id @default(uuid())
