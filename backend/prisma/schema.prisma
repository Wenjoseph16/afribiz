  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

// ============================================
// CAMPAIGN MODELS (Phase 5 — Marketing Automation)
// ============================================
model Campaign {
  id         String @id @default(uuid())
  businessId String

  name          String
  description   String?
  trigger       AutomationTrigger
  triggerConfig Json?                  @default("{}")
  status        CampaignStatus         @default(DRAFT)
  isTemplate    Boolean                @default(false)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  steps         CampaignStep[]
  executionLogs CampaignExecutionLog[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([businessId])
  @@index([trigger])
  @@index([status])
  @@index([isTemplate])
}

model CampaignStep {
  id           String               @id @default(uuid())
  campaignId   String
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder    Int
  name         String
  description  String?
  delayMinutes Int?
  delayHours   Int?
  delayDays    Int?
  actionType   AutomationActionType
  actionConfig Json
  conditions   Json?                @default("[]")
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([campaignId])
  @@index([stepOrder])
}

model CampaignExecutionLog {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepId     String?
  userId     String?
  businessId String?
  result     String   @default("SUCCESS")
  error      String?
  metadata   Json?
  executedAt DateTime @default(now())

  @@index([campaignId])
  @@index([executedAt])
}

// ============================================  
// MODULE DEMAND & MATCHING MODELS (Phase 6)
// ============================================

enum ModuleDemandStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ModuleDemand {
  id          String             @id @default(uuid())
  businessId  String
  moduleType  BusinessModule
  title       String
  description String?
  budget      Decimal?           @db.Decimal(12, 2)
  currency    String             @default("FCFA")
  deadline    DateTime?
  status      ModuleDemandStatus @default(OPEN)
  isUrgent    Boolean            @default(false)
  matches     ModuleMatch[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([businessId])
  @@index([moduleType])
  @@index([status])
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model ModuleMatch {
  id           String       @id @default(uuid())
  demandId     String
  demand       ModuleDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  developerId  String?
  moduleId     String?
  score        Int          @default(0) // Algorithmic match score (0-100)
  matchReasons String[]     @default([])
  status       MatchStatus  @default(PENDING)
  contactedAt  DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([demandId])
  @@index([developerId])
  @@index([moduleId])
  @@index([score])
  @@index([status])
}

model DemandSearchLog {
  id          String   @id @default(uuid())
  demandId    String
  query       String
  resultCount Int      @default(0)
  filters     Json?
  createdAt   DateTime @default(now())

  @@index([demandId])
  @@index([createdAt])
}

// ============================================
// GAMIFICATION MODELS (Phase 7 — Score + Badges + Quêtes + Défis)
// ============================================

enum QuestType {
  DAILY
  WEEKLY
  MONTHLY
  SPECIAL
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  ARCHIVED
}

enum StreakType {
  DAILY_LOGIN
  DAILY_ORDER
  DAILY_BOOKING
  DAILY_REVIEW
  DAILY_FOLLOW
  DAILY_STORY
  DAILY_SHORT
  DAILY_LIVE
}

model Quest {
  id          String      @id @default(uuid())
