  deliveryId String
  delivery   Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  url        String?
  value      String?
