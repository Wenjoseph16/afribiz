model ProductView {
  id         String   @id @default(uuid())
  businessId String
  productId  String
  userId     String?
  visitorId  String?
  ip         String?
  userAgent  String?
  referrer   String?
  source     String?  @default("direct")
  viewedAt   DateTime @default(now())

  @@index([businessId, productId])
  @@index([businessId, viewedAt])
  @@index([productId, viewedAt])
}


model ProductClick {
  id         String   @id @default(uuid())
  businessId String
  productId  String
  userId     String?
  visitorId  String?
  source     String?  @default("marketplace")
  clickedAt  DateTime @default(now())

  @@index([businessId, productId])
  @@index([businessId, clickedAt])
  @@index([productId, clickedAt])
}


model PageView {
  id         String    @id @default(uuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId     String?
  visitorId  String?
  url        String
  title      String?
  referrer   String?
  source     String?   @default("direct")
  ip         String?
  userAgent  String?
  durationMs Int?
  viewedAt   DateTime  @default(now())

  @@index([businessId, viewedAt])
  @@index([url, viewedAt])
  @@index([viewedAt])
  @@index([visitorId])
}


model AnalyticsEvent {
  id         String    @id @default(uuid())
  businessId String?
  userId     String?
  type       String
  category   String?
  eventName  String
  properties Json?
  value      Float?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([businessId, occurredAt])
  @@index([type, occurredAt])
  @@index([userId, occurredAt])
}


model ScheduledReport {
  id         String    @id @default(uuid())
  businessId String?
  userId     String?
  title      String
  type       String
  frequency  String
  format     String    @default("PDF")
  recipients String[]
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt   DateTime @updatedAt
  deliveries ReportDeliveryLog[]

  @@index([businessId])
  @@index([userId])
  @@index([isActive])
}


model ReportDeliveryLog {
  id        String           @id @default(uuid())
  reportId  String
  report    ScheduledReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  channel   String
  status    String
  error     String?
  sentAt    DateTime         @default(now())
  createdAt DateTime         @default(now())

  @@index([reportId])
  @@index([status])
}

// ============================================
// PUBLIC PLATFORM MODELS (CMS dynamique)
// ============================================


model MetricSnapshot {
  id         String   @id @default(uuid())
  businessId String?
  metric     String
  value      Float    @default(0)
  period     String
  snapshotAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([businessId, metric])
  @@index([businessId, snapshotAt])
}


model PeriodAggregation {
  id         String   @id @default(uuid())
  businessId String?
  period     String
  metric     String
  value      Float    @default(0)
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, period, metric, date])
  @@index([businessId, period, date])
}


model DashboardLayout {
  id         String   @id @default(uuid())
  userId     String?
  businessId String?
  role       String   @default("BUSINESS")
  layout     Json     @default("[]")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, businessId, role])
}


model DashboardWidget {
  id         String   @id @default(uuid())
  userId     String?
  businessId String?
  role       String   @default("BUSINESS")
  title      String
  type       String
  config     Json?    @default("{}")
  position   Int      @default(0)
  width      Int      @default(1)
  height     Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([businessId])
  @@index([role])
}

