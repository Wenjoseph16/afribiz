model Story {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaType      StoryMediaType   @default(IMAGE)
  mediaUrl       String
  caption        String?
  linkTargetType StoryTargetType?
  linkTargetId   String?
  linkUrl        String?
  stickers       Json?            @default("[]")
  isActive       Boolean          @default(true)
  isHighlight    Boolean          @default(false)
  expiresAt      DateTime
  viewsCount     Int              @default(0)
  clicksCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  views StoryView[]

  @@index([businessId])
  @@index([expiresAt])
  @@index([isHighlight])
  @@index([createdAt])
}


model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String?
  visitorId String?
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}


model FeedItem {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type           FeedItemType
  referenceId    String?
  mediaUrl       String?
  title          String?
  description    String?
  linkTargetType StoryTargetType?
  linkTargetId   String?
  linkUrl        String?
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  sortOrder      Int              @default(0)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([businessId])
  @@index([type])
  @@index([createdAt])
  @@index([isFeatured])
}

// ============================================
// OFFER FLASH MODELS (Phase 4 — Géolocalisation + Offres Flash)
// ============================================


model OfferFlash {
  id              String         @id @default(uuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  image           String?
  discountPercent Int            @default(0)
  originalPrice   Decimal?       @db.Decimal(12, 2)
  flashPrice      Decimal?       @db.Decimal(12, 2)
  currency        String         @default("FCFA")
  quantity        Int            @default(0)
  soldCount       Int            @default(0)
  maxPerCustomer  Int?           @default(1)
  terms           String?
  latitude        Float?
  longitude       Float?
  radiusKm        Int?           @default(5)
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  ClaimedOffer    ClaimedOffer[]

  @@index([businessId])
  @@index([endAt])
  @@index([isActive])
  @@index([latitude, longitude])
  @@index([createdAt])
}

// ============================================
// SHORTS BUSINESS MODELS (Phase 3 — Shorts Business)
// ============================================


model Short {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title          String?
  description    String?
  videoUrl       String
  thumbnailUrl   String?
  duration       Int?     @default(0)
  linkTargetType String?
  linkTargetId   String?
  linkUrl        String?
  isActive       Boolean  @default(true)
  likesCount     Int      @default(0)
  viewsCount     Int      @default(0)
  sharesCount    Int      @default(0)
  commentsCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  likes    ShortLike[]
  comments ShortComment[]
  views    ShortView[]
  savedBy  ShortSave[]

  @@index([businessId])
  @@index([createdAt])
  @@index([isActive])
}


model ShortLike {
  id        String   @id @default(uuid())
  shortId   String
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())

  @@unique([shortId, userId])
  @@index([shortId])
  @@index([userId])
}


model ShortComment {
  id        String   @id @default(uuid())
  shortId   String
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String   @default("Anonyme")
  content   String
  createdAt DateTime @default(now())

  @@index([shortId])
  @@index([createdAt])
}


model ShortView {
  id        String   @id @default(uuid())
  shortId   String
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  userId    String?
  visitorId String?
  createdAt DateTime @default(now())

  @@unique([shortId, userId])
  @@index([shortId])
  @@index([userId])
}


model ShortSave {
  id        String   @id @default(uuid())
  shortId   String
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([shortId, userId])
  @@index([shortId])
  @@index([userId])
}

// ============================================
// LIVE COMMERCE MODELS (Phase 2 — Lives Commerciaux)
// ============================================


model Live {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  coverImage      String?
  streamUrl       String?
  streamKey       String?
  status          LiveStatus @default(SCHEDULED)
  hasEscrow       Boolean    @default(false)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  viewerCount     Int        @default(0)
  maxViewers      Int?
  viewerCountPeak Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products     LiveProduct[]
  participants LiveParticipant[]
  chats        LiveChat[]
  reactions    LiveReaction[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}


model LiveProduct {
  id             String   @id @default(uuid())
  liveId         String
  live           Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  productId      String?
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  currency       String   @default("FCFA")
  image          String?
  stock          Int      @default(0)
  remainingStock Int      @default(0)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([liveId])
}


model LiveParticipant {
  id       String    @id @default(uuid())
  liveId   String
  live     Live      @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId   String?
  userName String?
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  isActive Boolean   @default(true)

  @@index([liveId])
  @@index([userId])
}


model LiveChat {
  id        String   @id @default(uuid())
  liveId    String
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String   @default("Anonyme")
  message   String
  createdAt DateTime @default(now())

  @@index([liveId])
  @@index([createdAt])
}


model LiveReaction {
  id        String   @id @default(uuid())
  liveId    String
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId    String?
  emoji     String   @default("❤️")
  createdAt DateTime @default(now())

  @@index([liveId])
}

// ============================================
// POSTS — User Generated Content (Phase 4)
// ============================================


model Post {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String?
  content     String
  excerpt     String?
  coverImage  String?
  images      String[]
  tags        String[]
  status      PostStatus @default(PUBLISHED)
  isPinned    Boolean    @default(false)
  likesCount  Int        @default(0)
  viewsCount  Int        @default(0)
  sharesCount Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  likes PostLike[]

  @@index([businessId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([businessId, status, createdAt])
}


model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ============================================
// NOTIFICATION MODELS
// ============================================


model Comment {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        CommentTargetType
  referenceId String
  content     String
  parentId    String?
  parent      Comment?          @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]         @relation("CommentReplies")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type, referenceId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

// ============================================
// CONTENT REPORTS (Phase 4)
// ============================================


model ContentReport {
  id           String              @id @default(uuid())
  reporterId   String
  reporter     User                @relation("ContentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  type         CommentTargetType
  referenceId  String
  reason       String
  description  String?
  status       ContentReportStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation("ReportReviewer", fields: [reviewedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([type, referenceId])
  @@index([reporterId])
  @@index([status])
}

// ============================================
// OPPORTUNITY DETECTION (Phase 3)
// ============================================


model ClaimedOffer {
  id        String     @id @default(uuid())
  offerId   String
  offer     OfferFlash @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@index([offerId])
  @@index([userId])
  @@index([offerId, userId])
}


model FaqEntry {
  id          String      @id @default(uuid())
  question    String
  answer      String
  categoryId  String?
  categoryRel FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder   Int         @default(0)
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([categoryId, sortOrder])
}


model FaqCategory {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  sortOrder   Int         @default(0)
  entries     FaqEntry[]
  createdAt   DateTime    @default(now())

  @@index([sortOrder])
}


model Testimonial {
  id          String   @id @default(uuid())
  name        String
  title       String?
  company     String?
  avatar      String?
  content     String
  rating      Int      @default(5)
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isFeatured])
  @@index([isPublished])
}


model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  bio         String?
  avatar      String?
  email       String?
  socialLinks Json?    @default("{}")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}


model SiteStat {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  value       String
  prefix      String?  @default("")
  suffix      String?  @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// PLATFORM MODELS (AdSlots, Localisation, i18n, Metriques, Dashboards)
// ============================================


model Region {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  countries Country[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Country {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  regionId     String
  region       Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  currency     String
  currencyCode String
  mobileMoney  String[]
  phoneCode    String?
  locales      String[]  @default(["fr"])
  isActive     Boolean   @default(true)
  cities       City[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([regionId])
  @@index([isActive])
}


model City {
  id        String   @id @default(uuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId, isActive])
}


model TranslationKey {
  id           String        @id @default(uuid())
  key          String        @unique
  namespace    String        @default("common")
  description  String?
  translations Translation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([namespace])
}


model Translation {
  id        String         @id @default(uuid())
  keyId     String
  key       TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale    String
  value     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([keyId, locale])
  @@index([locale])
}

