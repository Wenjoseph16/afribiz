model DeveloperProfile {
  id                     String                      @id @default(uuid())
  userId                 String                      @unique
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName            String?
  description            String?
  logo                   String?
  website                String?
  phone                  String?
  email                  String?
  country                String?
  city                   String?
  skills                 String[]
  specialties            String[]
  technologies           String[]
  experience             Int?
  portfolio              String?
  github                 String?
  linkedin               String?
  whatsapp               String?
  address                String?
  photo                  String?
  identityDocument       String?
  companyDocument        String?
  responsiblePhoto       String?
  verifiedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  isActive               Boolean                     @default(true)
  isVerified             Boolean                     @default(false)
  verificationStatus     DeveloperVerificationStatus @default(PENDING)
  rating                 Float                       @default(0)
  reviewCount            Int                         @default(0)
  modules                DeveloperModule[]
  supportTickets         DeveloperSupportTicket[]
  revenues               DeveloperRevenue[]
  payouts                DeveloperPayout[]
  developerModuleReviews DeveloperModuleReview[]
  apiKeys                DeveloperApiKey[]
  webhooks               ModuleWebhook[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  DeveloperBadge         DeveloperBadge[]
  followers              Follow[]
  approvedDemands        ModuleDemand[]
  moduleMatches          ModuleMatch[]

  @@index([userId])
}


model DeveloperModule {
  id                  String                        @id @default(uuid())
  developerId         String
  developer           DeveloperProfile              @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name                String
  slug                String                        @unique
  description         String?
  fullDescription     String?
  logo                String?
  images              String[]
  price               Decimal?                      @db.Decimal(12, 2)
  currency            String                        @default("FCFA")
  isFree              Boolean                       @default(false)
  isActive            Boolean                       @default(true)
  isPublished         Boolean                       @default(false)
  status              ModuleStatus                  @default(DRAFT)
  isVerified          Boolean                       @default(false)
  isFeatured          Boolean                       @default(false)
  category            String?
  subcategory         String?
  tags                String[]
  features            String[]
  requirements        String?
  setupGuide          String?
  version             String                        @default("1.0.0")
  rating              Float                         @default(0)
  reviewCount         Int                           @default(0)
  totalInstalls       Int                           @default(0)
  totalSales          Int                           @default(0)
  totalRevenue        Decimal                       @default(0) @db.Decimal(12, 2)
  publishedAt         DateTime?
  archivedAt          DateTime?
  pricingType         ModulePricingType?
  businessModule      String? // Maps to BusinessModule enum value if this module extends a native module
  installations       DeveloperModuleInstallation[]
  reviews             DeveloperModuleReview[]
  revenues            DeveloperRevenue[]
  supportTickets      DeveloperSupportTicket[]
  versions            DeveloperModuleVersion[]
  webhooks            ModuleWebhook[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  ModulePermission    ModulePermission[]
  ModuleConfiguration ModuleConfiguration[]
  ModuleActivityLog   ModuleActivityLog[]
  ModuleManifest      ModuleManifest?
  ModuleCommission    ModuleCommission[]
  ModuleLicense       ModuleLicense[]
  ModuleAnalytics     ModuleAnalytics[]
  ModuleErrorLog      ModuleErrorLog[]
  ModuleValidation    ModuleValidation[]
  moduleSubscriptions DeveloperModuleSubscription[]
  moduleMatches       ModuleMatch[]

  @@index([developerId])
  @@index([slug])
  @@index([isPublished])
  @@index([category])
}


model DeveloperModuleVersion {
  id               String                        @id @default(uuid())
  moduleId         String
  module           DeveloperModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  version          String
  releaseNotes     String?
  changelog        String?
  fileUrl          String?
  fileSize         Int?
  checksum         String?
  downloadCount    Int                           @default(0)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  ModuleManifest   ModuleManifest[]
  ModuleValidation ModuleValidation[]
  Installations    DeveloperModuleInstallation[]

  @@unique([moduleId, version])
  @@index([moduleId])
}


model DeveloperRevenue {
  id               String               @id @default(uuid())
  developerId      String
  developer        DeveloperProfile     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           DeveloperModule?     @relation(fields: [moduleId], references: [id])
  type             DeveloperRevenueType
  amount           Decimal              @db.Decimal(12, 2)
  commissionRate   Decimal              @db.Decimal(5, 4)
  commissionAmount Decimal              @db.Decimal(12, 2)
  netAmount        Decimal              @db.Decimal(12, 2)
  status           String               @default("PENDING") // e.g., PENDING, COMPLETED, CANCELLED
  sourceId         String? // e.g., Order ID, Subscription ID
  sourceType       String? // e.g., ORDER, SUBSCRIPTION
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ModuleCommission ModuleCommission?

  @@index([developerId])
  @@index([moduleId])
  @@index([type])
  @@index([status])
}


model DeveloperPayout {
  id               String           @id @default(uuid())
  developerId      String
  developer        DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(12, 2)
  currency         String           @default("FCFA")
  method           String
  status           String           @default("PENDING") // e.g., PENDING, COMPLETED, FAILED
  notes            String?
  requestedAt      DateTime         @default(now())
  processedAt      DateTime?
  processedBy      String?
  transactionId    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([developerId])
  @@index([status])
}

