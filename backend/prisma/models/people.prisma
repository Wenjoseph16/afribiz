model Partner {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  logo        String?
  website     String?
  phone       String?
  email       String?
  type        String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  // New fields
  category              PartnerCategory?    @default(FOURNISSEUR)
  collaborationLevel    CollaborationLevel? @default(PONCTUEL)
  whatsapp              String?
  address               String?
  city                  String?
  country               String?
  specialite            String?
  servicesProposes      String?
  produitsFournis       String?
  zonesCouvertes        String?
  horairesDisponibilite String?
  facebook              String?
  instagram             String?
  linkedin              String?
  tiktok                String?
  score                 Int                 @default(0)
  verifiedAt            DateTime?

  // Relations
  contracts    PartnerContract[]
  transactions PartnerTransaction[]
  assignments  PartnerAssignment[]
  reviews      PartnerReview[]
  documents    PartnerDocument[]
  permissions  PartnerPermission[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  PlanningTask PlanningTask[]

  @@index([businessId])
  @@index([category])
  @@index([score])
}

// ============================================
// REVIEW MODELS
// ============================================


model ClientNote {
  id               String         @id @default(uuid())
  businessClientId String
  businessClient   BusinessClient @relation(fields: [businessClientId], references: [id], onDelete: Cascade)
  content          String
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([businessClientId])
}


model ClientSegment {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#6366f1")
  conditions  Json?
  isDynamic   Boolean  @default(true)
  isActive    Boolean  @default(true)

  clients   SegmentClient[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}


model Employee {
  id             String                @id @default(uuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  photo          String?
  phone          String
  whatsapp       String?
  email          String?
  gender         String?
  address        String?
  city           String?
  country        String?
  position       String
  department     String?
  employeeRoleId String?
  employeeRole   EmployeeRole?         @relation(fields: [employeeRoleId], references: [id])
  hireDate       DateTime?
  salary         Decimal?              @db.Decimal(12, 2)
  salaryCurrency String                @default("FCFA")
  pinCode                 String?
  maxDiscountPercentage   Decimal?              @db.Decimal(5, 2)
  isRegistered            Boolean               @default(false)
  userId         String?
  user           User?                 @relation(fields: [userId], references: [id])
  status         EmployeeStatus        @default(ACTIVE)
  isActive       Boolean               @default(true)
  schedules      EmployeeSchedule[]
  attendances    Attendance[]
  documents      EmployeeDocument[]
  performances   EmployeePerformance[]
  activities     EmployeeActivity[]
  assignedTasks  PlanningTask[]        @relation("TaskAssignee")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  Payroll        Payroll[]
  Leave          Leave[]

  @@index([businessId])
  @@index([status])
  @@index([department])
  @@index([userId])
}


model EmployeeDocument {
  id             String               @id @default(uuid())
  businessId     String
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           EmployeeDocumentType
  title          String
  description    String?
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  expiresAt      DateTime?
  isExpired      Boolean              @default(false)
  expiryNotified Boolean              @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([businessId])
  @@index([employeeId])
  @@index([expiresAt])
}


model Payroll {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  baseSalary  Decimal       @db.Decimal(12, 2)
  bonuses     Decimal?      @default(0) @db.Decimal(12, 2)
  deductions  Decimal?      @default(0) @db.Decimal(12, 2)
  overtime    Decimal?      @default(0) @db.Decimal(12, 2)
  netAmount   Decimal       @db.Decimal(12, 2)
  currency    String        @default("FCFA")
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([businessId])
  @@index([employeeId])
  @@index([status])
}

