  countryCode     String
  taxId           String?
  taxRate         Decimal  @db.Decimal(5, 2)
  isVatRegistered Boolean  @default(false)
  vatNumber       String?
  filingFrequency String   @default("monthly")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, countryCode])
  @@index([businessId])
  @@index([countryCode])
}


model TaxReport {
  id            String          @id @default(uuid())
  businessId    String
  countryCode   String
  period        String
  totalRevenue  Decimal         @db.Decimal(12, 2)
  taxableAmount Decimal         @db.Decimal(12, 2)
  taxAmount     Decimal         @db.Decimal(12, 2)
  currency      String          @default("FCFA")
  status        TaxReportStatus @default(DRAFT)
  filedAt       DateTime?
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([businessId])
  @@index([countryCode])
  @@index([period])
}


model WhatsAppTemplate {
  id         String   @id @default(uuid())
  businessId String
  name       String
  category   String   @default("MARKETING")
  language   String   @default("fr")
  header     String?
  body       String
  footer     String?
  buttons    Json?
  status     String   @default("APPROVED")
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}


model WhatsAppSession {
  id            String    @id @default(uuid())
  businessId    String
  clientPhone   String
  clientName    String?
  status        String    @default("ACTIVE")
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@index([businessId])
  @@index([clientPhone])
}


model WhatsAppMessage {
  id           String          @id @default(uuid())
  sessionId    String
  fromBusiness Boolean         @default(true)
  content      String?
  mediaUrl     String?
  messageType  String          @default("text")
  waMessageId  String?
  status       String          @default("sent")
  metadata     Json?
  createdAt    DateTime        @default(now())
  session      WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}


model OfflineSyncQueue {
  id         String    @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  payload    Json?
  status     String    @default("PENDING")
  retryCount Int       @default(0)
  error      String?
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}


model VoiceQuery {
  id             String           @id @default(uuid())
  userId         String?
  businessId     String?
  audioUrl       String?
  transcript     String?
  detectedLang   String?          @default("fr")
  query          String
  resultType     String?
  resultIds      String[]
  status         VoiceQueryStatus @default(PROCESSING)
  processingTime Int?
  error          String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([businessId])
  @@index([status])
}


model VoiceCommand {
  id        String   @id @default(uuid())
  command   String
  action    String
  params    Json?
  language  String   @default("fr")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// ANALYTICS & REPORTS (TOME-24/25)
// ============================================model AdSlot {
  id          String      @id @default(uuid())
  page        String
  position    String
  label       String
  description String?
  width       Int         @default(0)
  height      Int         @default(0)
  // Prix configurables par l'admin (FCFA) — l'annonceur choisit emplacement + durée
  price1Day   Decimal     @default(0) @db.Decimal(12, 2)
  price7Days  Decimal     @default(0) @db.Decimal(12, 2)
  price30Days Decimal     @default(0) @db.Decimal(12, 2)
  maxPerSlot  Int         @default(10)
  isActive    Boolean     @default(true)
  campaigns   AdCampaign[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([page, position])
  @@index([page, position, isActive])
}

// ============================================
// ÉPARGNE ACHAT (Layaway sécurisé — escrow)
// ============================================

enum LayawayStatus {
  ACTIVE
  READY
  COMPLETED
  CANCELLED
}

model LayawayOffer {
  id             String       @id @default(uuid())
  businessId     String
  itemType       String
  itemId         String
  durationDays   Int          @default(90)
  minInstallment Decimal      @default(2000) @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  planCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  plans          LayawayPlan[]

  @@unique([itemType, itemId])
  @@index([businessId])
}

model LayawayPlan {
  id             String               @id @default(uuid())
  businessId     String
  clientId       String
  offerId       String
  offer         LayawayOffer  @relation(fields: [offerId], references: [id])
  itemType       String
  itemId         String
  itemName       String
  itemImage      String?
  targetAmount   Decimal              @db.Decimal(12, 2)
  savedAmount    Decimal              @default(0) @db.Decimal(12, 2)
  minInstallment Decimal              @default(2000) @db.Decimal(12, 2)
  durationDays   Int                  @default(90)
  status         LayawayStatus        @default(ACTIVE)
  escrowId       String?
  orderId        String?
  startedAt      DateTime             @default(now())
  expiresAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  reminder7dSent Boolean              @default(false)
  reminder3dSent Boolean              @default(false)
  reminder1dSent Boolean              @default(false)
  reminder7dAt   DateTime?
  reminder3dAt   DateTime?
  reminder1dAt   DateTime?
  contributions  LayawayContribution[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([clientId])
  @@index([businessId])
  @@index([offerId])
  @@index([status])
}

model LayawayContribution {
  id        String      @id @default(uuid())
  planId    String
  plan   LayawayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount    Decimal     @db.Decimal(12, 2)
  currency  String      @default("FCFA")
  method    String
  status    String      @default("PAID")
  paymentId String?
  reference String?
  createdAt DateTime    @default(now())

  @@index([planId])
}

// ============================================
// ENQUÊTES DE SATISFACTION CLIENT
// ============================================

model SatisfactionSurveyResponse {
  id         String   @id @default(uuid())
  userId     String
  businessId String?
  orderId    String?
  bookingId  String?
  score      Int
  feedback   String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([userId])
  @@index([orderId])
  @@index([score])
}

// ============================================
// CATALOGUE — RATTACHEMENT UNIFIÉ (Chantier 2)
// ============================================

model CatalogAttachment {
  id         String   @id @default(uuid())
  businessId String
  itemType   String   // PRODUCT | SERVICE | MENU_ITEM | ROOM | RENTAL | EVENT | TRAINING
  itemId     String
  sourceType String   // DISCOUNT_TIER | NEGOTIATION | CUSTOM_BADGE | WHATSAPP_TEMPLATE | STORY | SHORT | LIVE | ...
  sourceId   String?  // id du mécanisme si rattaché à une entité existante
  scopeType  String   @default("ITEM") // ALL | CATEGORY | ITEM
  categoryId String?
  config     Json?    @default("{}")
  isActive   Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, itemType, itemId, isActive])
  @@index([sourceType, sourceId])
  @@index([scopeType, categoryId])
}
