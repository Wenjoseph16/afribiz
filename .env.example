# ═══════════════════════════════════════════════
# AfriBiz — Environment Configuration
# ═══════════════════════════════════════════════
# Copy this file to .env and adjust values.
#   cp .env.example .env
# ═══════════════════════════════════════════════

# ─── Application ───────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ──────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/afribiz

# ─── Redis (optional, for caching/sessions) ────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@afribiz.com
SMTP_FROM_NAME=AfriBiz

# ─── Email (alternative providers) ─────────────
RESEND_API_KEY=
SENDGRID_API_KEY=

# ─── SMS ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
AFRISMS_API_KEY=
AFRISMS_SENDER=AfriBiz

# ─── Push Notifications (Web Push / VAPID) ─────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@afribiz.com

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=100
SENSITIVE_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=200

# ─── Auth / Security ───────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_MS=900000
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=3
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_HOURS=1
ENCRYPTION_KEY=

# ─── File Upload ───────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ─── Payments ──────────────────────────────────
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Speech-to-Text ────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
GOOGLE_SPEECH_KEY=

# ─── WhatsApp ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
FACEBOOK_API_VERSION=v18.0

# ─── Observability ─────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Cron ──────────────────────────────────────
CRON_SECRET=

# ─── Frontend (NEXT_PUBLIC_*) ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=AfriBiz
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=

# ─── E2E Tests (Playwright) ────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3000
