{
  "name": "afribiz",
  "version": "1.0.0",
  "description": "AfriBiz - Enterprise African SaaS Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n \"BE,FE\" -c \"blue,green\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:debug": "concurrently -n \"BE,FE\" -c \"blue,green\" \"npm run dev:debug -w backend\" \"npm run dev -w frontend\"",
    "prisma:generate": "npm exec -w backend -- prisma generate",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:test": "npm run db:seed:test -w backend",
    "build:backend": "npm run prisma:generate && npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm start -w backend",
    "lint": "npm run lint -ws",
    "format": "npm run format -ws",
    "type-check": "npm run type-check -ws",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:unit": "npm run test:unit -w backend && npm run test:unit -w frontend",
    "test:integration": "npm run test:integration -w backend",
    "test:coverage": "npm run test:coverage -w backend && npm run test:coverage -w frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:lighthouse": "lighthouse-ci --collect.numberOfRuns=3 --assert.preset=lighthouse:recommended",
    "audit:lighthouse": "lhci autorun",
    "audit": "npm audit --audit-level=high",
    "audit:deps": "npm audit --audit-level=high",
    "k6:smoke": "k6 run k6/smoke-test.js",
    "k6:load": "k6 run k6/load-test.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "keywords": [
    "saas",
    "african",
    "fintech",
    "marketplace"
  ],
  "author": "AfriBiz Team",
  "license": "MIT",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://Wenjoseph16@github.com/Wenjoseph16/afribiz.git"
  },
  
  "main": "ecosystem.config.cjs",
  "bugs": {
    "url": "https://github.com/Wenjoseph16/afribiz/issues"
  },
  "homepage": "https://github.com/Wenjoseph16/afribiz#readme",
  "dependencies": {
    "core-js": "^3.38.0"
  }
}
